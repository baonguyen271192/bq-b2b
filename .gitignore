# OS
.DS_Store

# Tài liệu nhị phân — KHÔNG version hoá trong git.
# Lý do: git lưu trọn vẹn từng phiên bản file nhị phân, không diff được; một file
# .pptx sửa 10 lần là 10 bản đầy đủ nằm vĩnh viễn trong lịch sử.
# Các mẫu đuôi file dưới đây đã phủ hết; không cần liệt kê thư mục cụ thể.
docs/**/*.pptx
docs/**/*.xlsx
docs/**/*.docx
docs/**/*.pdf
docs/**/*.mp4
docs/**/*.mov

# Ngoại lệ: bản PDF tổng hợp của đặc tả giao diện v2 là tài liệu nguồn, phải đi
# cùng SPEC.md và 23 ảnh chuẩn. Chỉ mở cho đúng thư mục này.
!docs/design/v2/*.pdf

# Java / Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# DB demo của backend Java (runtime artifact, sinh lại được)
apps/api-java/data/*.db
