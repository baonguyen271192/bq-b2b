# Sao chép file này thành .env rồi điền giá trị thật

# Token xác minh webhook — bạn tự đặt chuỗi bất kỳ, phải khớp với ô "Verify Token"
# khi cấu hình webhook trong Meta Developer Console.
VERIFY_TOKEN=bqbot-verify-2026

# Page Access Token của Fanpage (lấy trong Meta App > Messenger > Settings).
# Chưa có cũng chạy được: bot vẫn xử lý và log ra, chỉ không gửi lên Messenger thật.
PAGE_ACCESS_TOKEN=
