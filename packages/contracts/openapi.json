  "components": {
    "schemas": {
      "AdvanceBody": {
        "properties": {
          "actor": {
            "type": "string",
            "title": "Actor",
            "default": "Quản lý bán hàng"
          }
        },
        "type": "object",
        "title": "AdvanceBody"
      },
      "ApproveBody": {
        "properties": {
          "approve": {
            "type": "boolean",
            "title": "Approve"
          },
          "approver": {
            "type": "string",
            "title": "Approver",
            "default": "Quản lý bán hàng"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "approve"
        ],
        "title": "ApproveBody"
      },
      "AssistantBody": {
        "properties": {
          "dealer_code": {
            "type": "string",
            "title": "Dealer Code"
          },
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "dealer_code",
          "question"
        ],
        "title": "AssistantBody"
      },
      "CreateOrder": {
        "properties": {
          "dealer_code": {
            "type": "string",
            "title": "Dealer Code"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "type": "array",
            "title": "Lines"
          },
          "delivery": {
            "type": "string",
            "title": "Delivery",
            "default": "Kho HCM"
          },
          "payment": {
            "type": "string",
            "title": "Payment",
            "default": "Công nợ"
          },
          "channel": {
            "type": "string",
            "title": "Channel",
            "default": "app"
          }
        },
        "type": "object",
        "required": [
          "dealer_code",
          "lines"
        ],
        "title": "CreateOrder"
      },
      "DealerUpdate": {
        "properties": {
          "tier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tier"
          },
          "credit_limit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Credit Limit"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "invoice_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Invoice Address"
          }
        },
        "type": "object",
        "title": "DealerUpdate"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "OrderLine": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "sizes": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Sizes"
          }
        },
        "type": "object",
        "required": [
          "code",
          "sizes"
        ],
        "title": "OrderLine"
      },
      "PayBody": {
        "properties": {
          "method": {
            "type": "string",
            "title": "Method",
            "default": "Chuyển khoản"
          }
        },
        "type": "object",
        "title": "PayBody"
      },
      "ProductBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "retail": {
            "type": "integer",
            "title": "Retail"
          },
          "wholesale": {
            "type": "integer",
            "title": "Wholesale"
          },
          "sizes": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Sizes"
          },
          "images": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Images"
          }
        },
        "type": "object",
        "required": [
          "code",
          "name",
          "category",
          "retail",
          "wholesale",
          "sizes"
        ],
        "title": "ProductBody"
      },
      "SaleAssistantBody": {
        "properties": {
          "question": {
            "type": "string",
            "title": "Question"
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "SaleAssistantBody"
      },
      "ValidationError": {
