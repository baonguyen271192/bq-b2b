# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit .env.local.

# ----------------------------------------------------------------------------
# Trình duyệt (tiền tố NEXT_PUBLIC_ = lộ ra client, KHÔNG đặt secret ở đây)
# ----------------------------------------------------------------------------
# Để TRỐNG = gọi API cùng origin theo đường dẫn tương đối, Next rewrites proxy
# sang backend. Nhờ vậy chạy được cả localhost lẫn tunnel ngrok mà không sửa IP.
# Chỉ đặt khi muốn trỏ thẳng tới backend ở host khác.
NEXT_PUBLIC_API_BASE=

# ----------------------------------------------------------------------------
# Server-side — đích của rewrites trong next.config.ts
# ----------------------------------------------------------------------------
# Backend Java (apps/api-java). Để trống = http://localhost:8100
BQ_API_URL=

# Service Commerce (đơn khách lẻ qua bot) — nằm NGOÀI repo này.
# Để trống = http://localhost:8200
COMMERCE_API_URL=

# ----------------------------------------------------------------------------
# KHÔNG khai ở đây: VERCEL_OIDC_TOKEN do `vercel` CLI tự sinh vào .env.local.
# Nó là token, không được đưa vào file mẫu.
# ----------------------------------------------------------------------------
