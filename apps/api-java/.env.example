# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.

# ============================================================================
# NGUỒN DỮ LIỆU
# ============================================================================
# demo  = dữ liệu mẫu trong resources/demo + SQLite
# sapb1 = SAP Business One Service Layer
BQ_DATA_SOURCE=demo
BQ_DEMO_ORDERS_DB=data/orders.db

# ############################################################################
# SAU KHI KÝ HỢP ĐỒNG — chỉ cần ĐIỀN các biến dưới đây, KHÔNG sửa code.
# Mọi nhánh xử lý đều đã viết sẵn và có test; phần còn lại chỉ là giá trị.
# Đối chiếu với docs/sap-b1-mapping-proposal.md
# ############################################################################

# --- 1. Kết nối (bắt buộc) --------------------------------------------------
# Đổi /b1s/v1 -> /b1s/v2 nếu bản cài của BQ dùng v2.
SAPB1_BASE_URL=https://sap-server.bq.local:50000/b1s/v1
SAPB1_COMPANY_DB=
SAPB1_USERNAME=
SAPB1_PASSWORD=
# Bản cài nội bộ thường dùng cert tự ký. Chỉ đặt false trong LAN/VPN tin cậy.
SAPB1_VERIFY_SSL=true

# --- 2. Mã hàng theo size (bắt buộc — RỦI RO CAO NHẤT) ----------------------
# Mặc định giả định "<mã gốc>-<size>" (GBW0295-35). Sai quy tắc này = SAI SỐ LƯỢNG
# trong đơn gửi lên ERP thật. Xem một dòng OITM trước khi tin.
# SAPB1_SKU_PATTERN=^(?<base>[A-Za-z0-9]+)-(?<size>\d{2})$

# --- 3. Bậc đại lý ⇄ bảng giá (bắt buộc) ------------------------------------
SAPB1_TIER_BY_PRICELIST=1:Đồng,2:Bạc,3:Vàng,4:Kim Cương

# --- 4. Vòng đời đơn (bắt buộc) ---------------------------------------------
# BQ xác nhận B1 đã có đủ 5 trạng thái; chỉ cần tên trường UDF và giá trị.
SAPB1_ORDER_STATUS_FIELD=
SAPB1_ORDER_STATUS_VALUES=1:Chờ xác nhận,2:Đã xác nhận,3:Đang đóng gói,4:Đang bàn giao vận chuyển,5:Đại lý đã nhận
# Chỉ khai nếu B1 có trường lưu người duyệt / ghi chú duyệt:
SAPB1_ORDER_APPROVER_FIELD=
SAPB1_ORDER_APPROVE_NOTE_FIELD=

# --- 5. Kho và công thức tồn (chính sách bán hàng của BQ) -------------------
# Để trống kho = cộng tồn MỌI kho, ra số lớn hơn lượng thực bán sỉ được.
SAPB1_WAREHOUSE=
#   in_stock                 tồn thực tế (dễ bán vượt)
#   available                trừ phần đã giữ cho đơn khác   (mặc định)
#   available_with_incoming  cộng thêm hàng đang về
SAPB1_STOCK_FORMULA=available

# --- 6. Giá và thanh toán (quy trình kế toán của BQ) ------------------------
# SpecialPrices (giá riêng theo khách) ghi đè bảng giá. Tắt nếu BQ chỉ dùng bảng giá.
SAPB1_USE_SPECIAL_PRICES=true
# Thanh toán đối trừ vào: invoice (chuẩn) | order
SAPB1_PAYMENT_TARGET=invoice
# Chỉ khai nếu muốn hiện % chiết khấu theo bậc như bản demo (B1 không có khái niệm này):
# SAPB1_TIER_DISCOUNTS=Đồng:0,Bạc:0.03,Vàng:0.05,Kim Cương:0.08

# --- 7. Hiệu năng -----------------------------------------------------------
# Mỗi lần đọc danh mục là một request sang ERP. 0 = tắt cache (chỉ khi soi lỗi).
SAPB1_CATALOG_CACHE_TTL=PT5M

# ============================================================================
# KHÁC
# ============================================================================
# Trợ lý AI (service Python). PHẢI khác cổng của Java.
BQ_ASSISTANT_URL=http://localhost:8101
PORT=8100
# Demo để '*'. TRƯỚC KHI chạy với dữ liệu SAP thật: liệt kê domain cụ thể.
BQ_CORS_ORIGINS=*
# Tắt Swagger UI ở production: nó phơi toàn bộ bề mặt API.
SPRINGDOC_UI_ENABLED=true
