# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.
# Spring Boot đọc các biến này qua application.yml (xem ${...} trong đó).

# ============================================================================
# NGUỒN DỮ LIỆU — công tắc quan trọng nhất
# ============================================================================
# demo  = dữ liệu mẫu đóng gói trong resources/demo + SQLite (bản pitch)
# sapb1 = SAP Business One Service Layer
# Đổi giá trị này KHÔNG cần sửa controller, service, frontend hay mobile.
BQ_DATA_SOURCE=demo

# Đường dẫn DB demo. Mặc định trỏ sang bản Python để giữ lịch sử đơn demo.
BQ_DEMO_ORDERS_DB=../api/app/orders.db

# ============================================================================
# SAP BUSINESS ONE (chỉ cần khi BQ_DATA_SOURCE=sapb1)
# ============================================================================
# Service Layer thường ở cổng 50000. Đổi /b1s/v1 -> /b1s/v2 nếu bản cài dùng v2.
# PHẢI xác nhận với người quản trị B1 của BQ.
SAPB1_BASE_URL=https://sap-server.bq.local:50000/b1s/v1
SAPB1_COMPANY_DB=
SAPB1_USERNAME=
SAPB1_PASSWORD=

# Bản cài nội bộ thường dùng chứng chỉ tự ký. Chỉ đặt false trong LAN/VPN tin cậy.
SAPB1_VERIFY_SSL=true

# Kho xuất hàng sỉ. Để trống = cộng tồn mọi kho (ra số LỚN HƠN lượng bán được thật).
SAPB1_WAREHOUSE=

# Quy tắc mã hàng theo size. Mặc định giả định "<mã gốc>-<size>" (GBW0295-35).
# SAI quy tắc này = SAI SỐ LƯỢNG trong đơn gửi lên ERP. Xác nhận trước khi chạy thật.
# SAPB1_SKU_PATTERN=^(?<base>[A-Za-z0-9]+)-(?<size>\d{2})$

# Bảng giá B1 nào ứng với bậc đại lý nào của BQ.
# SAPB1_TIER_BY_PRICELIST=1:Đồng,2:Bạc,3:Vàng,4:Kim Cương

# ============================================================================
# TRỢ LÝ AI — vẫn là service Python (apps/api), Java proxy sang
# ============================================================================
# PHẢI khác server.port của chính Java, nếu không proxy gọi lại chính mình.
BQ_ASSISTANT_URL=http://localhost:8101

# ============================================================================
# KHÁC
# ============================================================================
PORT=8100
# Demo để '*'. TRƯỚC KHI lên thật với dữ liệu SAP B1: liệt kê domain cụ thể.
BQ_CORS_ORIGINS=*
