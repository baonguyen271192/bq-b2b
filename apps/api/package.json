{
  "name": "@bq/api",
  "version": "0.1.0",
  "private": true,
  "description": "Service trợ lý AI (Python/FastAPI). Không phải package Node — package.json chỉ để Turborepo điều phối lệnh.",
  "scripts": {
    "dev": "./.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8101 --reload",
    "start": "./.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8101}",
    "build": "./.venv/bin/python -m compileall -q app",
    "test": "./.venv/bin/python -m compileall -q app && ./.venv/bin/python -c 'import app.main'",
    "lint": "./.venv/bin/ruff check app",
    "typecheck": "echo '[@bq/api] CHƯA cấu hình mypy — quyết định riêng, xem báo cáo Phase 4'",
    "setup": "python3.12 -m venv .venv && ./.venv/bin/pip install -r requirements.txt",
    "clean": "rm -rf .venv __pycache__ .turbo",
    "format": "./.venv/bin/ruff format app"
  }
}
