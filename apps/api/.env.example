# Service trợ lý AI. Sao chép thành .env. KHÔNG commit .env.
#
# Service này KHÔNG có cơ sở dữ liệu riêng và KHÔNG cấu hình SAP B1 — mọi số liệu
# đọc từ backend Java. Cấu hình ERP nằm ở apps/api-java/.env.example.

# Backend Java để đọc dữ liệu. PHẢI khác cổng của chính service này.
BQ_API_URL=http://127.0.0.1:8100
BQ_API_TIMEOUT=20
BQ_API_CACHE_TTL=15

PORT=8101

# Chỉ đặt khi cần gọi thẳng từ trình duyệt lúc phát triển. Bình thường chỉ Java
# gọi service này qua proxy nội bộ nên không cần CORS.
# BQ_ASSISTANT_CORS=http://localhost:3000

# --- LLM (tuỳ chọn — không có vẫn chạy, chỉ mất phần trả lời bằng LLM) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# RAI_URL=

# --- Bot bán lẻ (Facebook Messenger) -----------------------------------------
# Chuỗi tự đặt, khai trùng ở Meta App > Messenger > Webhooks khi đăng ký.
FB_VERIFY_TOKEN=
# Meta App > Settings > Basic > App Secret. THIẾU = webhook TẮT (fail closed).
FB_APP_SECRET=
# Meta App > Messenger > Access Tokens, cấp cho đúng Trang của BQ.
# Thiếu thì bot vẫn chạy nhưng chỉ ghi log thay vì gửi tin — tiện lúc chưa được duyệt.
FB_PAGE_ACCESS_TOKEN=
# Khoá bắn đơn sang backend Java, PHẢI trùng BQ_RETAIL_INGEST_KEY bên apps/api-java.
BQ_RETAIL_INGEST_KEY=
# =1 bật POST /api/bot/simulate để chạy thử luồng khi chưa có Trang. Đơn tạo ra là
# đơn THẬT trong DB. Để trống ở môi trường chạy thật.
BQ_BOT_SIMULATE=
# File JSON chứa chính sách BÁN LẺ (phí ship, đổi trả, bảo hành...). Để trống thì
# bot thú nhận chưa biết và xin số điện thoại — KHÔNG bịa. Xem app/bot/policies.py.
BQ_RETAIL_POLICIES_FILE=
