# Service trợ lý AI. Sao chép thành .env. KHÔNG commit .env.
#
# Service này KHÔNG có cơ sở dữ liệu riêng và KHÔNG cấu hình SAP B1 — mọi số liệu
# đọc từ backend Java. Cấu hình ERP nằm ở apps/api-java/.env.example.

# Backend Java để đọc dữ liệu. PHẢI khác cổng của chính service này.
BQ_API_URL=http://127.0.0.1:8100
BQ_API_TIMEOUT=20
BQ_API_CACHE_TTL=15

PORT=8101

# Chỉ đặt khi cần gọi thẳng từ trình duyệt lúc phát triển. Bình thường chỉ Java
# gọi service này qua proxy nội bộ nên không cần CORS.
# BQ_ASSISTANT_CORS=http://localhost:3000

# --- LLM (tuỳ chọn — không có vẫn chạy, chỉ mất phần trả lời bằng LLM) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# RAI_URL=
