# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit .env.

# ============================================================================
# NGUỒN DỮ LIỆU — công tắc quan trọng nhất của backend
# ============================================================================
# demo  = dữ liệu mẫu trong repo (data.py/catalog.py + SQLite) — dùng cho pitch
# sapb1 = SAP Business One Service Layer — bật sau khi ký hợp đồng
#
# Đổi giá trị này KHÔNG cần sửa api.py, assistant.py, frontend hay mobile.
BQ_DATA_SOURCE=demo

# ============================================================================
# SAP BUSINESS ONE (chỉ cần khi BQ_DATA_SOURCE=sapb1)
# ============================================================================
# Service Layer thường chạy ở cổng 50000. Đổi /b1s/v1 thành /b1s/v2 nếu bản cài
# của BQ dùng v2. PHẢI xác nhận lại với người quản trị B1 của BQ.
SAPB1_BASE_URL=https://sap-server.bq.local:50000/b1s/v1
SAPB1_COMPANY_DB=
SAPB1_USERNAME=
SAPB1_PASSWORD=

# Bản cài nội bộ thường dùng chứng chỉ tự ký. Chỉ đặt false khi đường truyền là
# LAN/VPN tin cậy — tắt verify trên Internet công cộng là lỗ hổng thật.
SAPB1_VERIFY_SSL=true

# Kho xuất hàng sỉ. Để trống = cộng tồn mọi kho (ra số LỚN HƠN lượng bán được thật).
SAPB1_WAREHOUSE=

# Quy tắc mã hàng theo size. Mặc định giả định "<mã gốc>-<size>" (GBW0295-35).
# SAI quy tắc này = sai số lượng trong đơn gửi lên ERP → phải xác nhận trước khi chạy thật.
# SAPB1_SKU_PATTERN=^(?P<base>[A-Za-z0-9]+)-(?P<size>\d{2})$

# Bảng giá B1 nào ứng với bậc đại lý nào của BQ.
# SAPB1_TIER_BY_PRICELIST=1:Đồng,2:Bạc,3:Vàng,4:Kim Cương

# ============================================================================
# TRỢ LÝ AI (tuỳ chọn — không có vẫn chạy, chỉ mất phần trả lời bằng LLM)
# ============================================================================
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# RAI_URL=
